# 环境变量配置（复制为 .env 后填入实际值）

# ============================================================
# Kimi Code API 配置
# ============================================================
# 请根据你使用的 API 格式选择一套配置，注释掉另一套。
# 默认推荐使用 OpenAI 兼容格式。

# --- 方案 A：OpenAI 兼容格式（推荐）---
KIMI_API_KEY=sk-your-api-key-here
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-k2p5
KIMI_API_FORMAT=openai

# --- 方案 B：Anthropic 兼容格式 ---
# KIMI_API_KEY=sk-your-api-key-here
# KIMI_BASE_URL=https://api.kimi.com/coding/
# KIMI_MODEL=kimi-k2p5
# KIMI_API_FORMAT=anthropic

# ============================================================
# Tavily 搜索（研究员工具，可选）
# ============================================================
TAVILY_API_KEY=tvly-your-api-key-here

# ============================================================
# 运行配置
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# 数据层与队列（Phase 2）
# ============================================================

# Redis：Celery Broker + 任务状态缓存
REDIS_URL=redis://localhost:6379/0

# 数据库：SQLite（默认）或 Postgres
# SQLite 默认
DATABASE_URL=sqlite:///data/platform.db
# Postgres 示例（生产推荐）
# DATABASE_URL=postgresql://agent:agent123@localhost:5432/agent_platform

# ============================================================
# 向量数据库（Stage 2：RAG）
# ============================================================
VECTOR_STORE_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agent_memory
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================
# MCP 工具（Stage 3）
# ============================================================
MCP_ENABLED=true

# ============================================================
# ML 自动化评估（Stage 4）
# ============================================================
ML_EVAL_ENABLED=true
ML_EVAL_MODE=shadow          # shadow: 仅记录不融合；online: 与 LLM 融合；disabled: 禁用
ML_EVAL_WEIGHT_ML=0.3        # online 模式下 ML 评分权重

# ============================================================
# SFT 数据飞轮（Stage 5）
# ============================================================
SFT_ENABLED=true
SFT_MIN_SCORE=70             # 纳入 SFT 数据集的最低评分
SFT_MIN_SAMPLES=50           # 自动触发 SFT 训练的最小样本数
SFT_ROLES=D,B,E,C            # 启用 SFT 的角色

# ============================================================
# Go API Gateway（Stage 6）
# ============================================================
PORT=8080
API_KEY=your-api-key-here
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
LOG_LEVEL=info
ENABLE_METRICS=true
CORS_ALLOWED_ORIGINS=*
# TLS_CERT=cert.pem
# TLS_KEY=key.pem
SHUTDOWN_TIMEOUT=30s

# ============================================================
# 旧版 SQLite 会话数据库（保留兼容）
# ============================================================
# DATABASE_URL=sqlite:///data/sessions.db
